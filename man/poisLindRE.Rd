      \frac{\theta(\theta+1)}{\theta+2}
    \right)
  - \sum_{t=1}^{n_i}\log(y_{it}!)
  + \log\!\left(
      \left(\sum_{t=1}^{n_i}y_{it}\right)!
    \right)
  + \log\!\left(
      \sum_{t=1}^{n_i}\mu_{it}\frac{\theta(\theta+1)}{\theta+2}
      + \theta + \sum_{t=1}^{n_i}y_{it} + 1
    \right)
  - \left(\sum_{t=1}^{n_i}y_{it} + 2\right)
